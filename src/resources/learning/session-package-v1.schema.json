{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:afr:daily-practice:session-package:1",
  "title": "Пакет учебных сессий fr-ru — v1",
  "description": "Неизвестные поля запрещены. Схема проверяет структуру, а межобъектные ссылки, ID, циклы и редакторская готовность проверяются отдельно.",
  "$comment": "Лимиты синхронизированы с src/config/daily_practice.php этапа 01. Размер UTF-8 до 10485760 байт, глубина JSON до 32, повторные ключи объектов и отсутствие raw HTML проверяются до/после разбора серверным валидатором этапа 04; это не стандартные keywords JSON Schema.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "package_id": {
      "$ref": "#/$defs/id"
    },
    "language_pair": {
      "const": "fr-ru"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogLevel"
      },
      "minItems": 0,
      "maxItems": 7
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "curricula": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/curriculum"
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "language_pair",
    "sessions"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "sessions"
      ],
      "properties": {
        "sessions": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "curricula"
      ],
      "properties": {
        "curricula": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "^(?=[\\s\\S]*\\S)[^<>]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
    },
    "transcription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "allOf": [
        {
          "pattern": "[А-Яа-яЁё]"
        },
        {
          "pattern": "^[А-Яа-яЁё́\\s.,!?;:…()\\[\\]«»„“”\"'’/\\-–—]+$"
        }
      ]
    },
    "level": {
      "enum": [
        "PRE_A1",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "pronunciationNote": {
      "type": "object",
      "properties": {
        "fr": {
          "$ref": "#/$defs/text"
        },
        "transcription_ru": {
          "$ref": "#/$defs/transcription"
        }
      },
      "required": [
        "fr",
        "transcription_ru"
      ],
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "fr": {
          "$ref": "#/$defs/text"
        },
        "ru": {
          "$ref": "#/$defs/text"
        },
        "transcription_ru": {
          "$ref": "#/$defs/transcription"
        }
      },
      "required": [
        "fr",
        "ru",
        "transcription_ru"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "transcription_ru": {
          "$ref": "#/$defs/transcription"
        },
        "lang": {
          "const": "fr-FR"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      },
      "required": [
        "text",
        "transcription_ru",
        "lang",
        "asset_id"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "text_lang": {
          "enum": [
            "fr",
            "ru"
          ]
        },
        "transcription_ru": {
          "$ref": "#/$defs/transcription"
        }
      },
      "required": [
        "id",
        "text",
        "text_lang"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "text_lang": {
                "const": "fr"
              }
            },
            "required": [
              "text_lang"
            ]
          },
          "then": {
            "required": [
              "transcription_ru"
            ]
          }
        }
      ]
    },
    "prompt": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "text_lang": {
          "enum": [
            "fr",
            "ru"
          ]
        },
        "transcription_ru": {
          "$ref": "#/$defs/transcription"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        }
      },
      "required": [
        "text",
        "text_lang"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "text_lang": {
                "const": "fr"
              }
            },
            "required": [
              "text_lang"
            ]
          },
          "then": {
            "required": [
              "transcription_ru"
            ]
          }
        }
      ]
